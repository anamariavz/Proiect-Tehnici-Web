<!DOCTYPE html>
<html  lang="ro">
    <head>
        <meta name="description" content="Clinica noastră te întâmpină cu o echipă de profesioniști și tratamente personalizate."><!-- descrierea paginii, adesea apare sub link cand sunt afisate rezultatele cautarii -->
        <meta name="keywords" content="medici, stomatolog, tratamente, sănătate orală"><!--cuvintele cheie ale paginii; majoritatea motoarelor de cautare ignora keywords -->
        <link rel="stylesheet" href="/resurse/css/servicii.css" type="text/css" />
        <title>HappyDent</title>
        <%- include("../fragmente/head") %>     
        <script type="text/javascript" src=/resurse/js/servicii.js></script>
        <script type="text/javascript" src=/resurse/js/servicii-cos.js></script>

    </head>
    <body>
        <%- include("../fragmente/header") %> 
    <main>
        <div class ="continer mt-5">
            <div class="row justify-content-center mb-3">
                <div class="col-12 col-md-8">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="inp-nume" list="lista-servicii" class="form-control form-control-lg" placeholder="Caută după nume serviciu">
                        <ul id="lista-sugestii" class="autocomplete-list"></ul>
                    </div>
                    <datalist id="lista-servicii">
                        <% for (let serv of locals.servicii) { %>
                            <option value="<%- serv.nume %>">
                        <% } %>
                    </datalist>
                </div>
            </div>   
    
        <div class="row justify-content-center mb-3">
            <div class="col-12 col-md-4 d-flex justify-content-center mb-2 mb-md-0">
                <div class="btn-group" role="group" aria-label="Anestezie">
                    <input type="radio" class="btn-check" name="gr_anestezie" id="i_rad1" value="true" autocomplete="off">
                    <label class="btn btn-outline-primary btn-sm btn-super-sm" for="i_rad1">Cu anestezie</label>

                    <input type="radio" class="btn-check" name="gr_anestezie" id="i_rad2" value="false" autocomplete="off">
                    <label class="btn btn-outline-primary btn-sm btn-super-sm" for="i_rad2">Fără anestezie</label>

                    <input type="radio" class="btn-check" name="gr_anestezie" id="i_rad3" value="toate" autocomplete="off" checked>
                    <label class="btn btn-outline-primary btn-sm btn-super-sm" for="i_rad3">Toate</label>
                </div>
            </div>    

            <div class="col-12 col-md-8 d-flex justify-content-center align-items-center mb-2 mb-md-0 flex-wrap">
                <label class="form-label mb-0 me-2" for="inp-pret">Pret minim:</label>
                <input type="range" id="inp-pret" value="0" min="0" max="20000" class="form-range w-25 me-3">
                <span id="infoRange" class="me-3">(0)</span>
                <label class="form-label mb-0 me-2" for="inp-complexitate">Complexitate:</label>
                <select id="inp-complexitate" class="form-select w-auto">
                    <option id="sel-toate" selected value="toate">toate</option>
                    <% for (let opt of locals.optiuni) { %>
                    <option value="<%- opt.unnest %>"><%- opt.unnest %></option>
                    <% } %>
                </select>
            </div>
        </div>

        <!-- <div class="row justify-content-center mb-3"> -->
        <div class="row justify-content-center mb-3">
            <!-- Col select mai îngust -->
            <div class="col-12 col-md-4 d-flex flex-column justify-content-center">
                <label for="preturi" class="form-label">Selectează intervale de preț:</label>
                <select id="preturi" multiple size="6" class="form-select w-75 h-50">
                <option value="30-200">30 - 200 lei</option>
                <option value="200-1500">200 - 1500 lei</option>
                <option value="1500-2000">1500 - 2000 lei</option>
                <option value="2000-5000">2000 - 5000 lei</option>
                <option value="5000-10000">5000 - 10000 lei</option>
                <option value="10000-15000">10000 - 15000 lei</option>
                </select>
            </div>

            <!-- Col textarea care se întinde pe restul rândului -->
            <div class="col-12 col-md-8 d-flex align-items-center">
                <div class="form-floating w-100">
                <textarea class="form-control h-50" id="commentBox" placeholder="Cuvinte cheie"></textarea>
                <label for="commentBox">Cuvinte cheie</label>
                <div class="invalid-feedback">
                    Introdu cuvinte cheie valide (ex: +imagine -implant).
                </div>
                </div>
            </div>
        </div>

        <p>

        <div class="row justify-content-center mb-4">
            <div class="col-12 d-flex justify-content-center flex-wrap gap-2">
                <button id="filtrare" class="btn btn-primary d-flex align-items-center">
                    <i class="bi bi-funnel"></i>
                    <span class="d-none d-sm-inline ms-2">Filtrare</span>
                </button>
                <button id="sortCrescNume" class="btn btn-secondary d-flex align-items-center">
                    <i class="bi bi-sort-alpha-down"></i>
                    <span class="d-none d-sm-inline ms-2">Sorteaza crescator dupa pret si nume</span>
                </button>
                <button id="sortDescrescNume" class="btn btn-secondary d-flex align-items-center">
                    <i class="bi bi-sort-alpha-up"></i>
                    <span class="d-none d-sm-inline ms-2">Sorteaza descrescator dupa pret si nume</span>
                </button>
                <button id="resetare" class="btn btn-danger d-flex align-items-center">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span class="d-none d-sm-inline ms-2">Resetare</span>
                </button>
            </div>
        </div>
    </div>
      
        <p id="p-suma">Apăsați Alt+"c" pentru suma preturilor produselor afișate. </p>
        
        <section id="servicii">

            <h2>Servicii</h2>
            <div class="grid-servicii">
                <% for( let serv of locals.servicii) { %>
                    <article class="serviciu" >
                        <h3 class="nume">Nume: <a href="/serviciu/<%-serv.id %>" ><span class="val-nume"><%- serv.nume%></span></a></h3>
                        <div class="info-serv">
                            <p class="pret">Pret: <span class="val-pret"><%- serv.pret%></span></p>
                            <p class="anestezie">Anestezie: <span class="val-anestezie"><%- serv.necesita_anestezie %></span></p>
                            <p class="grad_complexitate">Complexitate: <span class="val-complexitate"><%- serv.grad_complexitate%></span></p>
                            <p class="durata">Durata: <span class="val-durata"><%- serv.durata%></span></p>
                        </div>
                        <div class="linie-serviciu">
                            <p class="tip_serviciu">Tip serviciu: <span class="val-tip_serviciu"><%- serv.tip_serviciu %></span></p>
                            <p class="categorie">Categorie: <span class="val-categorie"><%- serv.categorie %></span></p>
                        </div>
                        <div class="descriere-imagine">
                            <p class="descriere"><%- serv.descriere %></p>
                            <figure>
                                <img src="/resurse/imagini/servicii/<%- serv.imagine %>" alt="Imagine <%- serv.nume %>" />
                            </figure>
                        </div>
                        <div class="form-check form-switch">
                            <input type="checkbox" class="btn-check select-cos" id="select-cos-<%-serv.id%>" autocomplete="off">
                            <label class="btn btn-outline-success" for="select-cos-<%-serv.id%>">Selectează</label>
                        </div>
                    </article>
                <% }%>
            </div>
        </section>

    </main>
    <%- include("../fragmente/footer") %>
    </body>
</html>